# WebSocket endpoint for apps/coordinator (or the local simulator).
NEXT_PUBLIC_COORDINATOR_URL=ws://localhost:8787
# Must match the coordinator's ROOM_SECRET. This token is exposed to dashboard visitors;
# use it only with a coordinator that restricts dashboard client actions.
NEXT_PUBLIC_ROOM_TOKEN=dev-room-secret
# Optional. Without this, persona dialogue uses deterministic templates.
AI_GATEWAY_API_KEY=
PERSONA_MODEL=openai/gpt-5-mini
